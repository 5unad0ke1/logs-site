---
import { site } from '../config/site';
---

<section class="profile">
  <h1>{site.author}</h1>
  <p class="alias">a.k.a. {site.alias}</p>
  <p class="bio">{site.bio}</p>
</section>

<style>
  .profile {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 48px 0 40px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 40px;
    line-height: 1.3;
    font-weight: 700;
  }
  .alias {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--c-text-muted);
  }
  .bio {
    margin: 0;
    line-height: 1.8;
    color: var(--c-text-body);
    white-space: pre-line;
  }

  @media (max-width: 760px) {
    .profile {
      gap: 8px;
      padding: 36px 0 28px;
    }
    h1 {
      font-size: 32px;
    }
    .alias {
      font-size: 13px;
    }
    .bio {
      margin-top: 10px;
      font-size: 15px;
    }
  }
</style>
