---
import { formatDate } from '../lib/format';
import { isExternal, postUrl, sourceLabel, type Post } from '../lib/posts';
import HourglassIcon from './HourglassIcon.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<section class="list" aria-label="記事一覧">
  {posts.map((post) => {
    const external = isExternal(post);
    return (
      <a
        class="row"
        href={postUrl(post)}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener' : undefined}
      >
        <span class="title">
          {external ? (
            <svg
              class="icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--c-text-muted)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17L17 7" />
              <path d="M8 7h9v9" />
            </svg>
          ) : (
            <HourglassIcon class="icon" />
          )}
          <span>
            {post.data.title}
            {external && <span class="ext"> ↗</span>}
          </span>
          {post.data.draft && <span class="draft">[draft]</span>}
        </span>
        <span class="meta">
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>{' '}
          • {sourceLabel(post)}
        </span>
      </a>
    );
  })}
</section>

<style>
  .list {
    display: flex;
    flex-direction: column;
    padding: 16px 0 80px;
    border-top: 1px solid var(--c-border);
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 12px;
    text-decoration: none;
    color: var(--c-text);
  }
  .row:hover {
    background: var(--c-surface);
    color: var(--c-text);
  }
  .title {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 16.5px;
    font-weight: 500;
    line-height: 1.6;
  }
  .title :global(.icon) {
    flex: none;
    /* 1行目の中央に揃える */
    margin-top: calc((1.6em - 16px) / 2);
  }
  .ext {
    font-family: var(--font-mono);
    color: var(--c-text-muted);
  }
  .draft {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--c-accent);
  }
  .meta {
    padding-left: 26px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--c-text-muted);
  }

  @media (max-width: 760px) {
    .list {
      padding: 8px 0 48px;
    }
    .row {
      padding: 12px 0;
    }
    .title {
      font-size: 15.5px;
    }
  }
</style>
