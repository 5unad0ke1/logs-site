---
import { postUrl, type Post } from '../lib/posts';

interface Props {
  prev?: Post;
  next?: Post;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="prevnext" aria-label="前後の記事">
    {prev && (
      <a class="card prev" href={postUrl(prev)} rel="prev">
        <span class="dir">← prev</span>
        <span class="title">{prev.data.title}</span>
      </a>
    )}
    {next && (
      <a class="card next" href={postUrl(next)} rel="next">
        <span class="dir">next →</span>
        <span class="title">{next.data.title}</span>
      </a>
    )}
  </nav>
)}

<style>
  .prevnext {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--c-border);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border: 1px solid var(--c-border);
    text-decoration: none;
    color: var(--c-text);
  }
  .card:hover {
    border-color: var(--c-border-hover);
    color: var(--c-text);
  }
  .next {
    grid-column: 2;
    text-align: right;
  }
  .dir {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--c-text-muted);
  }
  .title {
    font-size: 14px;
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .prevnext {
      grid-template-columns: minmax(0, 1fr);
    }
    .next {
      grid-column: 1;
    }
  }
</style>
