---
import { getOgp } from '../../lib/ogp';

interface Props {
  url: string;
}

const { url } = Astro.props;
const ogp = await getOgp(url);
const host = new URL(url).hostname;
---

<a class="linkcard" href={url} target="_blank" rel="noopener">
  <span class="body">
    <span class="title">{ogp.title}</span>
    {ogp.description && <span class="desc">{ogp.description}</span>}
    <span class="host">{host}</span>
  </span>
  {ogp.image && (
    <span class="thumb">
      <img
        src={ogp.image}
        alt=""
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    </span>
  )}
</a>

<style>
  .linkcard {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--c-border);
    text-decoration: none;
    color: var(--c-text);
    overflow: hidden;
  }
  .linkcard:hover {
    border-color: var(--c-border-hover);
    color: var(--c-text);
  }
  .body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
  }
  .title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 13px;
    line-height: 1.6;
    color: var(--c-text-muted);
  }
  .host {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    color: var(--c-text-muted);
  }
  .thumb {
    flex: none;
    width: 160px;
    background: var(--c-surface);
    border-left: 1px solid var(--c-border);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 560px) {
    .body {
      padding: 14px 16px;
    }
    .thumb {
      width: 96px;
    }
  }
</style>
