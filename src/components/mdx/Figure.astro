---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** 記事フォルダの画像を import したもの、または public/外部画像の URL */
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  /** remark プラグイン(figure-number)が自動で付ける図番号 */
  num?: string;
  width?: number;
  height?: number;
}

const { src, alt, caption, num, width, height } = Astro.props;
const label = [num && `fig.${num}`, caption].filter(Boolean).join(' — ');
---

<figure class="figure">
  {typeof src === 'string' ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={[720, 1440]}
      sizes="(max-width: 760px) 100vw, 720px"
    />
  )}
  {label && <figcaption>{label}</figcaption>}
</figure>

<style>
  .figure {
    margin: 8px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  img {
    width: 100%;
    height: auto;
    border: 1px solid var(--c-border);
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--c-text-muted);
  }
</style>
