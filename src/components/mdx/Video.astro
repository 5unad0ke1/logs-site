---
import { figLabel } from '../../lib/format';
import type { ImageMetadata } from 'astro';

interface Props {
  /** YouTube の動画 ID */
  youtube?: string;
  /** 動画ファイルの URL(public/ 以下など) */
  src?: string;
  poster?: ImageMetadata | string;
  caption?: string;
  /** remark プラグイン(figure-number)が自動で付ける図番号 */
  num?: string;
}

const { youtube, src, poster, caption, num } = Astro.props;
if (!youtube && !src) {
  throw new Error('<Video> には youtube か src のどちらかが必要です');
}

const thumb =
  typeof poster === 'string'
    ? poster
    : (poster?.src ??
      (youtube
        ? `https://i.ytimg.com/vi/${youtube}/hqdefault.jpg`
        : undefined));
const label = figLabel(num, caption);
const watchUrl = youtube
  ? `https://www.youtube.com/watch?v=${encodeURIComponent(youtube)}`
  : undefined;
---

<figure class="video">
  <div
    class="frame"
    data-video
    data-youtube={youtube}
    data-src={src}
    data-title={caption ?? '動画'}
  >
    {thumb && <img class="thumb" src={thumb} alt="" loading="lazy" />}
    <button
      type="button"
      class="play"
      aria-label={caption ? `動画を再生: ${caption}` : '動画を再生'}
    >
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </button>
  </div>
  {(label || watchUrl) && (
    <figcaption>
      <span>{label}</span>
      {watchUrl && (
        <a class="watch" href={watchUrl} target="_blank" rel="noopener">
          YouTube で見る ↗
        </a>
      )}
    </figcaption>
  )}
</figure>

<script>
  // クリックされるまで iframe / video を作らない(読み込みを軽くする)
  for (const frame of document.querySelectorAll<HTMLElement>('[data-video]')) {
    frame.querySelector('.play')?.addEventListener(
      'click',
      () => {
        const { youtube, src, title = '動画' } = frame.dataset;
        let player: HTMLElement;
        if (youtube) {
          const iframe = document.createElement('iframe');
          // youtube-nocookie.com だと閲覧者のログイン状態が使えず、
          // 再生時に「bot ではないことを確認」画面が出やすいので通常ドメインを使う
          iframe.src = `https://www.youtube.com/embed/${encodeURIComponent(youtube)}?autoplay=1&rel=0`;
          // YouTube の埋め込みはリファラ(埋め込み元)が無いと再生を拒否する
          iframe.referrerPolicy = 'strict-origin-when-cross-origin';
          iframe.title = title;
          iframe.allow =
            'autoplay; encrypted-media; picture-in-picture; fullscreen';
          iframe.allowFullscreen = true;
          player = iframe;
        } else {
          const video = document.createElement('video');
          video.src = src ?? '';
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          player = video;
        }
        player.className = 'player';
        frame.replaceChildren(player);
        player.focus();
      },
      { once: true },
    );
  }
</script>

<style>
  .video {
    margin: 8px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--c-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
  }
  .play {
    position: relative;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--c-accent);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.15s;
  }
  .play:hover {
    transform: scale(1.06);
  }
  .play svg {
    fill: var(--c-bg);
  }
  .frame :global(.player) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--c-text-muted);
  }
  .watch {
    color: var(--c-text-muted);
  }
  .watch:hover {
    color: var(--c-text);
  }
</style>
