---
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <span>
    © {year} {site.copyright}
  </span>
</footer>

<style>
  .footer {
    padding: 32px 0 48px;
    border-top: 1px solid var(--c-border);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--c-text-muted);
  }
</style>
