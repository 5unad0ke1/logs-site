---
import HourglassIcon from './HourglassIcon.astro';

interface Props {
  size?: 'sm' | 'md';
  href?: string;
}

const { size = 'md', href } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['logo', size]} href={href}>
  <HourglassIcon size={size === 'md' ? 22 : 20} />
  <span>
    砂時計<span class="accent">/log</span>
  </span>
</Tag>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--c-text);
  }
  .md {
    font-size: 18px;
  }
  .sm {
    font-size: 17px;
  }
  .accent {
    color: var(--c-accent);
  }
</style>
