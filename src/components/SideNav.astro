---
import Logo from './Logo.astro';
import NavLinks from './NavLinks.astro';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<aside class="side">
  <Logo href="/" />
  <NavLinks current={current} variant="side" />
  <ThemeSwitch variant="side" />
  <slot />
</aside>

<style>
  .side {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 48px 0 24px;
  }
</style>
