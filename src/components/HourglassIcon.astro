---
interface Props {
  size?: number;
  color?: string;
  class?: string;
}

const { size = 16, color = 'var(--c-accent)', class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M6 2h12"></path>
  <path d="M6 22h12"></path>
  <path d="M7 2v4l5 6-5 6v4"></path>
  <path d="M17 2v4l-5 6 5 6v4"></path>
</svg>
